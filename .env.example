# No API key or external account is required. Node does not auto-load this file.
PORT=8787
# Optional absolute path; contains personal data. Never commit it.
# DATA_PATH=/absolute/private/dranbleib.sqlite

# Authenticated candidate only: replace with an owned HTTPS origin before public use.
# PUBLIC_ORIGIN=https://dranbleib.localhost
# PORT=8791
# DATA_PATH=/absolute/private/release.sqlite

# Release mode defaults to closed signup; operator-created test accounts only.
# ALLOW_SIGNUP=true is for deliberately configured local tests, not this public preview.
# OPENAI_DOMAIN_CHALLENGE is set only to the actual token from the authorized portal.
